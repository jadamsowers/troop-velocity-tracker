# Copy this file to .env and fill in the value below.
#
# Cloudflare Zero Trust dashboard →
#   Networks → Tunnels → your tunnel → Configure →
#   "Install and run a connector" → Docker.
# Copy the long string that appears after `--token` in the shown command.
#
# In the tunnel's Public Hostnames tab, point your hostname at
#   Service:  HTTP
#   URL:      app:8080
# `app` is the service name in docker-compose.yml, resolvable on the
# internal `tunnel` bridge network.

TUNNEL_TOKEN=
